<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloading the toolchain bundle + crates.io search. That's all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- R4A: open the installer for an exported game APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Declared for API 34+ devices; enforcement is off at targetSdk 28 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Folders opened in place (Download, anywhere on shared storage).
         targetSdk 28 keeps the legacy storage model, so this one runtime
         grant is what lets the File API (and cargo, which needs real POSIX
         paths) read+write those folders. Requested only when the user
         actually opens a folder as a project. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".RustDroidApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RustDroid">

        <!-- R4A: hands exported game APKs to the installer / share sheet -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.rustdroid.ide.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/r4a_export_paths" />
        </provider>

        <!-- R4A: runs a game the user compiled (miniquad/macroquad .so).
             Own process: a native library can not be unloaded, so each run
             starts a fresh process. Not exported: only R4A opens it.
             Own task: "back" slides to the code while the game stays alive
             (paused) behind; R4A brings it back without reloading it. -->
        <activity
            android:name=".game.GameActivity"
            android:process=":game"
            android:exported="false"
            android:taskAffinity="dev.rustdroid.ide.game"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open .rs sources from file managers / share sheets. Two
                 filters: proper MIME types where providers send them, and
                 wildcard-MIME + pathPattern for the common
                 "content://...something/main.rs" shapes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/x-rust" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.rs" />
            </intent-filter>
        </activity>

        <!-- Toolchain download/extract/verify. Foreground so a 1.2 GB
             download survives screen-off and backgrounding. -->
        <service
            android:name=".toolchain.ToolchainInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phase 4 terminal sessions (plan §8.3). dataSync is correct at
             targetSdk 28 (type enforcement off); the eventual type is
             specialUse — recorded as a targetSdk-28 migration blocker in
             DEVIATIONS.md §10. Keeps the PROCESS alive while ≥ 1 session
             exists; NOT a claim of session persistence across app death
             (plan §5.4: app death closes the pty master and the kernel
             SIGHUPs the foreground process group). -->
        <service
            android:name=".runtime.terminal.TerminalService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
